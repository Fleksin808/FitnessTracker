<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FitnessTracker.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="25">
            <Label
                Text="Deník tréninků"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Zadej název svého tréninku." />

            <Entry
                x:Name="WorkoutNameEntry"
                Placeholder="Například: Trénink nohou"
                SemanticProperties.Description="Název tréninku" />

            <Button
                Text="Potvrdit trénink"
                Clicked="OnWorkoutClicked"
                HorizontalOptions="Fill" />

            <Label
                x:Name="WorkoutResultLabel"
                Text="Zatím nemáš zadaný trénink." />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
