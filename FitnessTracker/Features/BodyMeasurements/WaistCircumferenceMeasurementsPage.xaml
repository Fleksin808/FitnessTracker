<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:measurements="clr-namespace:FitnessTracker.Features.BodyMeasurements"
             x:Class="FitnessTracker.Features.BodyMeasurements.WaistCircumferenceMeasurementsPage"
             x:Name="MeasurementsPage"
             x:DataType="measurements:WaistCircumferenceMeasurementsViewModel"
             Title="Obvod pasu">
    <Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="12">
        <VerticalStackLayout Spacing="8">
            <Label Text="Obvod pasu" Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Zadej centimetry. Záznam dostane čas pořízení a uloží se přesně na milimetry." />
            <Entry Text="{Binding CentimetersInput, Mode=TwoWay}"
                   Placeholder="Například 82,5 cm" Keyboard="Numeric"
                   IsEnabled="{Binding CanInteract}"
                   SemanticProperties.Description="Obvod pasu v centimetrech" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="Uložit měření" Command="{Binding AddCommand}" />
                <Button Text="Obnovit" Command="{Binding ReloadCommand}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            </HorizontalStackLayout>
            <Label Text="{Binding StatusMessage}" />
            <Label Text="{Binding ErrorMessage}" TextColor="Red" />
            <Label Text="Historie měření" FontAttributes="Bold" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Measurements}" SelectionMode="None"
                        EmptyView="Zatím nemáš uložené žádné měření obvodu pasu.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="measurements:WaistCircumferenceMeasurementItem">
                    <Grid Padding="8" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <Label Text="{Binding CircumferenceText}" FontAttributes="Bold" />
                        <Label Grid.Row="1" Text="{Binding MeasuredAtText}" />
                        <Button Grid.Column="1" Grid.RowSpan="2" Text="Smazat"
                                Clicked="OnDeleteMeasurementClicked"
                                IsEnabled="{Binding ViewModel.CanInteract, Source={x:Reference MeasurementsPage}, x:DataType=measurements:WaistCircumferenceMeasurementsPage}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
