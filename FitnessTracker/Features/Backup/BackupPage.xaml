<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:backup="clr-namespace:FitnessTracker.Features.Backup"
             x:Class="FitnessTracker.Features.Backup.BackupPage"
             x:DataType="backup:BackupViewModel"
             Title="Záloha">
    <VerticalStackLayout Padding="24" Spacing="12">
        <Label Text="Záloha a obnova" Style="{StaticResource Headline}"
               SemanticProperties.HeadingLevel="Level1" />
        <Label Text="Export vytvoří JSON soubor s tréninky, katalogem cviků a celou historií." />
        <Button Text="Exportovat zálohu" Clicked="OnExportClicked" IsEnabled="{Binding IsIdle}" />
        <Button Text="Obnovit ze souboru" Clicked="OnRestoreClicked" IsEnabled="{Binding IsIdle}" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        <Label Text="{Binding StatusMessage}" />
    </VerticalStackLayout>
</ContentPage>
