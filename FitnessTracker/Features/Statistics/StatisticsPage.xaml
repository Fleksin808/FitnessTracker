<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:statistics="clr-namespace:FitnessTracker.Features.Statistics"
             x:Class="FitnessTracker.Features.Statistics.StatisticsPage"
             x:DataType="statistics:StatisticsViewModel"
             Title="Statistiky">
    <ScrollView>
      <VerticalStackLayout Padding="24" Spacing="12">
        <Label Text="Statistiky" Style="{StaticResource Headline}"
               SemanticProperties.HeadingLevel="Level1" />
        <Label Text="Přehled za celou historii. Zahrnuje i rozpracované tréninky." />
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
            <Label Text="Tréninky celkem" />
            <Label Grid.Column="1" Text="{Binding WorkoutCountText}" />
            <Label Grid.Row="1" Text="Z toho ukončeno" />
            <Label Grid.Row="1" Grid.Column="1" Text="{Binding FinishedCountText}" />
            <Label Grid.Row="2" Text="Zaznamenané série" />
            <Label Grid.Row="2" Grid.Column="1" Text="{Binding SetCountText}" />
            <Label Grid.Row="3" Text="Objem zátěže" />
            <Label Grid.Row="3" Grid.Column="1" Text="{Binding VolumeText}" />
        </Grid>
        <Label Text="Objem = součet opakování × zadaná vnější zátěž. Série bez zátěže se vynechávají." />
        <BoxView HeightRequest="1" />
        <Label Text="Týdenní cíl" FontAttributes="Bold" />
        <Label Text="Počítají se dokončené tréninky od pondělí do začátku dalšího týdne podle místního času." />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Text="{Binding WeeklyGoalInput, Mode=TwoWay}" Placeholder="Tréninky za týden"
                   Keyboard="Numeric" IsEnabled="{Binding CanInteract}"
                   SemanticProperties.Description="Cílový počet dokončených tréninků za týden" />
            <Button Grid.Column="1" Text="Uložit cíl" Command="{Binding SaveWeeklyGoalCommand}" />
        </Grid>
        <Label Text="{Binding WeeklyProgressText}" FontAttributes="Bold" />
        <Label Text="{Binding WeeklyGoalStatusText}" />
        <Label Text="{Binding GoalMessage}" />
        <BoxView HeightRequest="1" />
        <Label Text="Týdenní připomínka" FontAttributes="Bold"
               IsVisible="{Binding IsReminderSupported}" />
        <HorizontalStackLayout Spacing="10" IsVisible="{Binding IsReminderSupported}">
            <Switch x:Name="WeeklyReminderSwitch" IsEnabled="{Binding CanInteract}"
                    Toggled="OnWeeklyReminderToggled"
                    SemanticProperties.Description="Zapnout týdenní připomínku v neděli v 18 hodin" />
            <Label Text="Neděle v 18:00" VerticalOptions="Center" />
        </HorizontalStackLayout>
        <Label Text="{Binding ReminderMessage}" IsVisible="{Binding IsReminderSupported}" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        <Button Text="Obnovit statistiky" Command="{Binding ReloadCommand}" />
        <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="Red" />
      </VerticalStackLayout>
    </ScrollView>
</ContentPage>
