<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:workouts="clr-namespace:FitnessTracker.Features.Workouts"
             xmlns:models="clr-namespace:FitnessTracker.Domain.Exercises"
             x:Class="FitnessTracker.Features.Workouts.WorkoutDetailPage"
             x:Name="DetailPage"
             x:DataType="workouts:WorkoutDetailViewModel" Title="Detail tréninku">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <VerticalStackLayout IsVisible="{Binding HasWorkout}" Spacing="8">
                <Label Text="{Binding WorkoutName}" Style="{StaticResource Headline}" />
                <Label Text="{Binding StartedAtText}" />
                <Label Text="{Binding FinishedAtText}" />
                <Button Text="Smazat trénink" Clicked="OnDeleteWorkoutClicked"
                        IsEnabled="{Binding CanDeleteWorkout}" />
                <VerticalStackLayout IsVisible="{Binding IsOpenWorkout}" Spacing="8">
                    <!-- Nabídka je katalog; následující picker vybírá konkrétní výskyt cviku v tréninku. -->
                    <Picker Title="Cvik z aktivního katalogu" ItemsSource="{Binding AvailableExercises}"
                            ItemDisplayBinding="{Binding Name, x:DataType=models:Exercise}"
                            SelectedItem="{Binding SelectedExercise}" IsEnabled="{Binding CanRecord}" />
                    <Button Text="Přidat cvik do tréninku" Command="{Binding AddExerciseCommand}" />
                    <Picker Title="Cvik pro novou sérii" ItemsSource="{Binding RecordedExercises}"
                            ItemDisplayBinding="{Binding DisplayName, x:DataType=workouts:WorkoutExerciseItem}"
                            SelectedItem="{Binding SelectedRecordedExercise}" IsEnabled="{Binding CanRecord}" />
                    <Entry Text="{Binding RepetitionsInput}" Placeholder="Počet opakování" Keyboard="Numeric" IsEnabled="{Binding CanRecord}" />
                    <Entry Text="{Binding LoadKilogramsInput}" Placeholder="Zátěž v kg (prázdné = nezadaná)" Keyboard="Numeric" IsEnabled="{Binding CanRecord}" />
                    <Button Text="Přidat sérii" Command="{Binding AddSetCommand}" />
                    <Button Text="Ukončit trénink" Command="{Binding FinishCommand}" />
                </VerticalStackLayout>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecordedExercises}" Spacing="16">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="workouts:WorkoutExerciseItem">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding DisplayName}" FontAttributes="Bold" />
                                <HorizontalStackLayout Spacing="8">
                                    <Button Text="Cvik výš" Command="{Binding ViewModel.MoveExerciseUpCommand, Source={x:Reference DetailPage}, x:DataType=workouts:WorkoutDetailPage}" CommandParameter="{Binding Exercise.Id}" />
                                    <Button Text="Cvik níž" Command="{Binding ViewModel.MoveExerciseDownCommand, Source={x:Reference DetailPage}, x:DataType=workouts:WorkoutDetailPage}" CommandParameter="{Binding Exercise.Id}" />
                                </HorizontalStackLayout>
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sets}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="workouts:WorkoutSetItem">
                                            <VerticalStackLayout Spacing="4" Padding="0,4">
                                                <Label Text="{Binding DisplayText}" />
                                                <HorizontalStackLayout Spacing="8">
                                                    <Button Text="Série výš" Command="{Binding ViewModel.MoveSetUpCommand, Source={x:Reference DetailPage}, x:DataType=workouts:WorkoutDetailPage}" CommandParameter="{Binding Set.Id}" />
                                                    <Button Text="Série níž" Command="{Binding ViewModel.MoveSetDownCommand, Source={x:Reference DetailPage}, x:DataType=workouts:WorkoutDetailPage}" CommandParameter="{Binding Set.Id}" />
                                                    <Button Text="Upravit" Command="{Binding ViewModel.EditSetCommand, Source={x:Reference DetailPage}, x:DataType=workouts:WorkoutDetailPage}" CommandParameter="{Binding Set.Id}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <!-- Editor je sdílený pro vybranou sérii; dovolí opravit i ukončenou historii. -->
                <VerticalStackLayout IsVisible="{Binding IsEditingSet}" Spacing="8">
                    <Label Text="Upravit sérii" FontAttributes="Bold" />
                    <Label Text="{Binding SelectedSetText}" />
                    <Entry Text="{Binding EditRepetitionsInput}" Placeholder="Počet opakování"
                           Keyboard="Numeric" IsEnabled="{Binding CanEditRecordedData}" />
                    <Entry Text="{Binding EditLoadKilogramsInput}" Placeholder="Zátěž v kg (prázdné = nezadaná)"
                           Keyboard="Numeric" IsEnabled="{Binding CanEditRecordedData}" />
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Uložit opravu" Command="{Binding SaveSetEditCommand}" />
                        <Button Text="Zrušit" Command="{Binding CancelSetEditCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
            <Label Text="{Binding StatusMessage}" />
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
            <Button Text="Znovu načíst detail" Command="{Binding RetryCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
