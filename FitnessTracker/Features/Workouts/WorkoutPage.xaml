<?xml version="1.0" encoding="utf-8" ?>
<!-- x:DataType umožní kontrolovat názvy vlastností bindingu při sestavení. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:workouts="clr-namespace:FitnessTracker.Features.Workouts"
             xmlns:models="clr-namespace:FitnessTracker.Domain.Workouts"
             x:Class="FitnessTracker.Features.Workouts.WorkoutPage"
             x:DataType="workouts:WorkoutViewModel"
             Title="Tréninky">
    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="24" Spacing="12" Grid.Row="0">
            <Label Text="Deník tréninků" Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Zadej název svého tréninku." />
            <!-- TwoWay přenáší text mezi vstupním polem a ViewModelem oběma směry. -->
            <Entry Text="{Binding WorkoutName, Mode=TwoWay}"
                   Placeholder="Například: Trénink nohou"
                   SemanticProperties.Description="Název tréninku" />
            <!-- Příkaz nahrazuje obsluhu události Clicked v code-behind. -->
            <Button Text="Potvrdit trénink" Command="{Binding ConfirmWorkoutCommand}" />
            <!-- Indikátor sleduje skutečný stav operace ve ViewModelu. -->
            <ActivityIndicator IsRunning="{Binding IsSaving}"
                               IsVisible="{Binding IsSaving}"
                               SemanticProperties.Description="Ukládání tréninku" />
            <!-- Výsledek se přenáší pouze z ViewModelu do zobrazení. -->
            <Label Text="{Binding WorkoutResult, Mode=OneWay}" />
            <!-- Selhání prvního otevření databáze musí být viditelné a umožnit další pokus. -->
            <Label Text="{Binding LoadError}" />
            <Button Text="Obnovit seznam" Command="{Binding LoadWorkoutsCommand}" />
        </VerticalStackLayout>
        <!-- Jednoduchý výběr předá navigaci ID tréninku; po otevření se výběr vyčistí. -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Workouts}" EmptyView="Zatím nemáš žádné tréninky"
                        SelectionMode="Single" SelectionChanged="OnWorkoutSelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Workout">
                    <Label Text="{Binding Name}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
