<?xml version="1.0" encoding="utf-8" ?>
<!-- x:DataType umožní kontrolovat názvy vlastností bindingu při sestavení. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:workouts="clr-namespace:FitnessTracker.Features.Workouts"
             x:Class="FitnessTracker.Features.Workouts.WorkoutPage"
             x:DataType="workouts:WorkoutViewModel"
             Title="Tréninky">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="25">
            <Label Text="Deník tréninků" Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Zadej název svého tréninku." />
            <!-- TwoWay přenáší text mezi vstupním polem a ViewModelem oběma směry. -->
            <Entry Text="{Binding WorkoutName, Mode=TwoWay}"
                   Placeholder="Například: Trénink nohou"
                   SemanticProperties.Description="Název tréninku" />
            <!-- Příkaz nahrazuje obsluhu události Clicked v code-behind. -->
            <Button Text="Potvrdit trénink" Command="{Binding ConfirmWorkoutCommand}"
                    HorizontalOptions="Fill" />
            <!-- Výsledek se přenáší pouze z ViewModelu do zobrazení. -->
            <Label Text="{Binding WorkoutResult, Mode=OneWay}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
